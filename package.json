{
  "name": "argvia",
  "version": "0.0.0",
  "private": true,
  "description": "Composable foundations for TypeScript command-line applications.",
  "type": "module",
  "scripts": {
    "check": "vp check",
    "build": "vp run -r build",
    "test": "vp test --passWithNoTests",
    "ready": "vp run build && vp check && vp run test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
